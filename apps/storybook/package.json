{
  "name": "storybook",
  "private": true,
  "type": "module",
  "scripts": {
    "build:packages": "pnpm --dir ../.. --filter './packages/*' build",
    "dev": "pnpm build:packages && storybook dev -p 6006",
    "build": "pnpm build:packages && storybook build",
    "test": "pnpm build:packages && vitest run",
    "typecheck": "tsc --project tsconfig.json --pretty false"
  },
  "dependencies": {
    "@themoment-team/design-system-react": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.65.1",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
