{
  "name": "themoment-design-system",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build --filter=./packages/*",
    "test:storybook": "turbo run test --filter=storybook",
    "test:consumers": "node scripts/test-consumers.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0"
}
